#!/usr/bin/env bash
# pre-commit — refuse to commit while `check-tdd-evidence.py --prove` has source files BROKEN.
#
# Why this exists (bug 2026-07-14-06).
#
# `--prove` proves each TDD guard discriminates by APPLYING A BREAK to a real, tracked source file,
# running the guard test (must go RED), then restoring it. The mutation is real and it is on disk.
#
# Bug 2026-07-13-06 hardened the WORKING TREE against a *killed* prove: the original bytes are
# persisted to `.claude/tdd-prove-inflight.json` before the break, and any surviving sentinel is
# healed at the next startup. That works.
#
# It does NOT protect against a CONCURRENT COMMIT. A `git add -A` (or any commit) issued while a
# prove is mid-flight snapshots the BROKEN tree. The prove then finishes and restores the file
# perfectly — so the working tree is clean, every test passes, and nothing looks wrong. The damage
# is frozen in the commit, invisible.
#
# That is exactly what happened on 2026-07-14: commit 508f5e0f captured `for a in range(1):` — the
# a guard's break — silently disabling the guarded behaviour for anyone who checked
# out that commit. It was caught only because `git status` showed an unexpected modification AFTER
# the prove restored the file.
#
# The sentinel already tells us precisely when the tree is untrustworthy. This hook just reads it.
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
INFLIGHT="$REPO_ROOT/.claude/tdd-prove-inflight.json"

# Prefer the repo venv interpreter (uniform with .githooks/pre-push); this call only
# reads stdlib JSON, so the resolution is for consistency, not a missing dep. No-op when
# the venv is already active. Fall back to python/python3 if there is no venv.
if [ -x "$REPO_ROOT/.venv/bin/python" ]; then
    PY="$REPO_ROOT/.venv/bin/python"
elif command -v python >/dev/null 2>&1; then
    PY="python"
else
    PY="python3"
fi

if [ -f "$INFLIGHT" ]; then
  broken_file="$("$PY" -c "
import json, sys
try:
    print(json.load(open(r'$INFLIGHT', encoding='utf-8')).get('file', '<unknown>'))
except Exception:
    print('<unreadable sentinel>')
" 2>/dev/null || echo '<unknown>')"

  cat >&2 <<EOF

[pre-commit] BLOCKED — a 'check-tdd-evidence.py --prove' run is IN FLIGHT.

  A guard's break is currently applied to:  $broken_file

  Source files on disk are DELIBERATELY BROKEN right now. Committing would freeze that break into
  history: the prove will restore the file moments later, so the working tree ends up clean and every
  test passes, and the corrupted commit looks completely normal. (Bug 2026-07-14-06; the same class
  as 2026-07-13-06.)

  What to do:
    - Wait for the --prove run to finish, then commit. It restores the source and clears the sentinel.
    - If no prove is actually running, it was killed. Run any check-tdd-evidence.py invocation to
      self-heal, or restore by hand:
          git checkout -- $broken_file && rm -f .claude/tdd-prove-inflight.json

EOF
  exit 1
fi

exit 0
