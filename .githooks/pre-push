#!/bin/bash
# Pre-push hook: git-lfs object upload + full survey-wide validation gate.
# Activated via: git config core.hooksPath .githooks
# To bypass for an explicit reason, use `git push --no-verify`.
#
# This hook REPLACES the stock .git/hooks/pre-push (the git-lfs hook) once
# core.hooksPath points here, so it must itself chain `git lfs pre-push` or LFS
# pointers would be pushed without their blobs (bug 2026-07-02-03).
set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# --- 1. Git LFS: upload objects for the refs being pushed (reads the ref list
# from this hook's stdin, exactly as the stock git-lfs hook does). ---
if command -v git-lfs >/dev/null 2>&1; then
    git lfs pre-push "$@" || exit 1
fi

# --- 2. Pick a python that actually runs. git-bash on Windows aliases python3
# and python to a non-functional Microsoft-Store stub (exit 49); the py launcher
# resolves the real interpreter. On Linux/macOS python3 works and is chosen first. ---
PY=""
for c in python3 python "py -3"; do
    if $c -c "import sys" >/dev/null 2>&1; then PY="$c"; break; fi
done
if [ -z "$PY" ]; then
    echo "[pre-push] no working python found — LFS uploaded, skipping validators." >&2
    exit 0
fi

echo "[pre-push] Running survey-wide validation (python: $PY)..."
fail=0
SURVEY_DIRS=$(find surveys -maxdepth 2 -name order.json -exec dirname {} \; | sort -u)
if [ -z "$SURVEY_DIRS" ]; then
    echo "[pre-push] No survey dirs (surveys/*/order.json) found — nothing to validate."
else
    for d in $SURVEY_DIRS; do
        echo "[pre-push]   validating $d"
        $PY viewer/tools/validate-refs.py "$d" || fail=1
        $PY viewer/tools/renumber-equations.py --check "$d" || fail=1
        $PY viewer/tools/renumber-paragraphs.py --check "$d" || fail=1
        $PY viewer/tools/renumber-sections.py --check "$d" || fail=1
        # Bare-ref severity for the push gate: always error (the per-edit hook may
        # be in warn mode during migration, but push to remote is the strict gate).
        $PY viewer/tools/validate-refs.py --bare-refs-only --severity=error "$d" || fail=1
    done
fi

# Cross-link gap check (corpus-level). Advisory at 'warn'; blocks only at 'error'.
XSEV=$(cat .claude/crosslink-severity 2>/dev/null || echo warn)
if [ "$XSEV" != "off" ] && [ -f .claude/crosslink-scope ]; then
    XSCOPE=$(grep -vE '^[[:space:]]*#|^[[:space:]]*$' .claude/crosslink-scope | tr '\n' ' ')
    $PY viewer/tools/crosslink.py check $XSCOPE --severity="$XSEV" \
        --min-score 0.18 || fail=1
fi

if [ $fail -ne 0 ]; then
    echo "[pre-push] BLOCKED - fix the errors above before pushing." >&2
    echo "[pre-push] To bypass for an explicit reason: git push --no-verify" >&2
    exit 1
fi

echo "[pre-push] Clean. Proceeding with push."
exit 0
