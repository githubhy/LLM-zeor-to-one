# Python
__pycache__/
*.py[cod]
.pytest_cache/

# Cache-warmer runtime markers + validation dirty-flag (session-local, transient)
.claude/cache-warmer.*.active
.claude/validate-refs.dirty
.claude/.tmp/
# Per-turn API-usage telemetry (session-keyed JSONL; machine-local, not shared)
**/.claude/diagnostics/

# Acquired full-text sources: PDFs are tracked via Git LFS (see .gitattributes).
# Still ignore any other (non-PDF) contents of download/.
download/*
!download/.gitkeep
!download/*.pdf

# Node (viewer server deps; install via `cd viewer && npm install`)
node_modules/

# Viewer test/deploy artifacts (Playwright + multi-root publish bundle)
viewer/test-results/
viewer/playwright-report/
viewer/dist/

# Viewer-generated local reader state (per-user highlight annotations,
# keyed to a document revision — machine-local, not shared)
.viewer-highlights/

# OS / editor
.DS_Store
*.swp

# Regenerable connector SigLIP feature cache (1.4GB) — reproduce recomputes it
artifacts/connector-ablation/features.npz
artifacts/**/features.npz

# Machine-local Claude Code settings. Upstream had this TRACKED until 2026-07-26,
# which published a personal notification topic (public-by-name — anyone with repo
# read access could subscribe or publish) in a Stop hook that then fired in every
# clone, plus one machine's permission allowlist carrying a stale absolute
# scratchpad path from an unrelated session. Genuinely shared hooks belong in the
# tracked .claude/settings.json; anything machine-specific stays here and out of git.
.claude/settings.local.json

# check-tdd-evidence --prove crash sentinel (transient; marks source as BROKEN in-flight)
.claude/tdd-prove-inflight.json

# Ad-hoc scratch dirs. EXCEPT surveys/**/_scratch/ — that is the deep-research-survey
# evidence-ledger convention and is deliberately TRACKED; a bare `_scratch/` silently
# un-stages every new survey's evidence ledger.
_scratch/
!surveys/**/_scratch/
# Root-level _scratch/ holds two tracked audit records that predate this rule, so
# ignore its CONTENTS rather than the directory: gitignore cannot re-include a file
# whose parent DIRECTORY is excluded, which is why the plain `!_scratch/<file>` form
# silently does nothing.
!/_scratch/
/_scratch/*
!/_scratch/h9audit-*.md

# Resumable per-run scratch checkpoints (leading-underscore _*_ckpt_*.json); the
# deliverable is the final summary artifact, not the churning per-flush checkpoint.
artifacts/**/_*_ckpt_*.json

# Centrally-extracted plain text of PDFs already committed under download/.
# Derived duplicate text does not belong in history.
surveys/*/_scratch/txt/

# Rasterised page images from copyrighted PDFs — throwaway intermediates for reading
# a figure. The PDF in download/ is the artifact of record; the extracted numbers go in
# the _scratch ledger. Never commit the page images themselves.
surveys/**/_scratch/*_png/
